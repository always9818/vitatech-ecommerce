// Prisma schema for VITATECH e-commerce
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "workerd"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  FAILED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  // Nulo cuando la cuenta se creó con Google: no hay contraseña que guardar.
  passwordHash  String?
  // Foto de perfil que devuelve Google al iniciar sesión.
  image         String?
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cart            Cart?
  orders          Order[]
  reviews         Review[]
  shippingProfile ShippingProfile?
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  price       Int
  oldPrice    Int
  stock       Int
  rating      Float
  reviews     Int
  icon        String
  images      String[]
  description String
  specs       Json

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])

  cartItems   CartItem[]
  orderItems  OrderItem[]
  productReviews Review[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@index([brandId])
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([productId, userId])
  @@index([productId, status])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  type        CouponType
  value       Int
  active      Boolean    @default(true)
  expiresAt   DateTime?
  usageLimit  Int?
  usageCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  carts       Cart[]
  orders      Order[]
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestId   String?    @unique
  items     CartItem[]
  couponId  String?
  coupon    Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int

  @@unique([cartId, productId])
}

model Order {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id])
  items              OrderItem[]
  subtotal           Int
  shipping           Int
  discount           Int
  couponId           String?
  coupon             Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponDiscount     Int         @default(0)
  total              Int
  status             OrderStatus @default(PENDING)
  recurrenteCheckoutId String?   @unique

  // Copia congelada de la dirección al momento de comprar. Se guarda aquí y no
  // solo como referencia al perfil porque si el cliente luego se muda, este
  // pedido debe seguir mostrando a dónde se envió realmente.
  // Opcionales porque los pedidos anteriores a esta función no la tienen.
  shipRecipientName  String?
  shipPhone          String?
  shipDepartment     String?
  shipMunicipality   String?
  shipAddressLine    String?
  shipZone           String?
  shipReference      String?

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

/// Dirección guardada del cliente, para no volver a escribirla en cada compra.
model ShippingProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  department    String
  municipality  String
  addressLine   String
  zone          String?
  reference     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  unitPrice  Int
}

// Registro único (id fijo "main") con configuración editable del sitio:
// la imagen de portada del hero de la home y sus textos.
//
// Los textos son opcionales: cuando valen null se usan los valores por defecto
// de HERO_DEFAULTS (src/lib/site-settings.ts). Una cadena vacía NO es lo mismo
// que null — significa "ocultar ese elemento" (ver resolveHeroContent).
/// Cada diseño del carrusel de la portada.
model HeroSlide {
  id        String   @id @default(cuid())
  imageUrl  String
  /// A dónde lleva al hacer clic (opcional). Ej: /catalogo?cat=Laptops
  linkUrl   String?
  /// Texto alternativo, para lectores de pantalla y si la imagen no carga.
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model SiteSettings {
  id              String   @id @default("main")
  /// Heredado: la portada de una sola imagen. Se conserva para no romper los
  /// sitios que aún no tienen diapositivas; si hay HeroSlide, manda el carrusel.
  heroImageUrl    String?
  heroBadge       String?
  heroTitle       String?
  heroTitleAccent String?
  heroSubtitle    String?
  updatedAt       DateTime @updatedAt
}
