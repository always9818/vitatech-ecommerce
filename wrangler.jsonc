{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vitatech-ecommerce",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "www.importadoravitatech.com", "custom_domain": true },
    { "pattern": "importadoravitatech.com", "custom_domain": true }
  ],
  "r2_buckets": [
    {
      "bucket_name": "vitatech-product-images",
      "binding": "PRODUCT_IMAGES"
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-f5e3eee06ae444ed8a574cb56350cc48.r2.dev"
  },
  "observability": {
    "enabled": true
  }
}
