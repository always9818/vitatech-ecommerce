{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vitatech-ecommerce",
  // Envoltorio sobre el worker que genera OpenNext (custom-worker.ts, en la
  // raíz del proyecto): reexporta el mismo `fetch` tal cual y le suma el
  // handler `scheduled` para el cron de carritos abandonados.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // El dominio se sirve con `routes` + `zone_name` (ver abajo), que es la forma
  // que coincide con lo registrado en el panel: Workers & Pages → Domains,
  // ambos hostnames como tipo Route.
  //
  // NO declararlo como `{ "custom_domain": true }`: esa forma hace que cada
  // deploy intente reclamar el dominio contra /workers/scripts/.../domains/records
  // y, cuando esa llamada falla, wrangler aborta con "No targets deployed" —
  // el Worker queda subido pero la versión nueva nunca se activa y el sitio se cae.
  "r2_buckets": [
    {
      "bucket_name": "vitatech-product-images",
      "binding": "PRODUCT_IMAGES"
    },
    // Caché de datos de OpenNext (lo que guardan los `unstable_cache` de
    // catalog.ts). Bucket PRIVADO y distinto al de las fotos: no debe quedar
    // expuesto en el dominio público r2.dev. El nombre del binding lo exige
    // OpenNext, no es libre.
    {
      "bucket_name": "vitatech-next-cache",
      "binding": "NEXT_INC_CACHE_R2_BUCKET"
    }
  ],
  // Registro de invalidaciones por etiqueta: es lo que hace que un cambio hecho
  // en el panel se vea de inmediato en la tienda en vez de esperar a que expire
  // la caché. El nombre del binding también lo exige OpenNext.
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "vitatech-next-tags",
      "database_id": "9628aaf7-0b8c-44a1-9ea4-c011614939c6"
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://pub-f5e3eee06ae444ed8a574cb56350cc48.r2.dev",
    "NEXT_PUBLIC_APP_URL": "https://importadoravitatech.com",
    "NEXTAUTH_URL": "https://importadoravitatech.com",
    // Dominio verificado en Resend (subdominio, no la raíz, para no tocar el
    // SPF/MX que usa Zoho para el correo normal de importadoravitatech.com).
    "RESEND_FROM_EMAIL": "VITATECH <noreply@notificaciones.importadoravitatech.com>",
    // ID de medición público de Google Analytics 4 (no es secreto). El script
    // en layout.tsx solo se activa si esta variable existe.
    "NEXT_PUBLIC_GA_ID": "G-ZHKSV94ZFY",
    // ID público del Meta Pixel (no es secreto, es el mismo que va en el
    // código de instalación "manual" de Meta). Mismo patrón: el script en
    // layout.tsx solo se activa si esta variable existe.
    "NEXT_PUBLIC_META_PIXEL_ID": "1042501291850371"
  },
  // Apagado a propósito, igual que en el panel: la tienda se sirve solo desde el
  // dominio propio. En `true`, cada deploy vuelve a publicar
  // vitatech-ecommerce.<cuenta>.workers.dev como copia pública del sitio.
  "workers_dev": false,
  "routes": [
    { "pattern": "importadoravitatech.com/*", "zone_name": "importadoravitatech.com" },
    { "pattern": "www.importadoravitatech.com/*", "zone_name": "importadoravitatech.com" }
  ],
  // Dos disparadores, y custom-worker.ts decide qué hacer según cuál entró
  // (Cloudflare pasa la expresión en `event.cron`):
  //
  //   "0 * * * *"    cada hora en punto: revisa carritos abandonados y manda
  //                  el recordatorio a los que llevan quietos el tiempo
  //                  suficiente (ver src/lib/abandoned-cart.ts).
  //   "*/5 * * * *"  cada 5 minutos: solo un SELECT 1 para que Prisma
  //                  Postgres no se suspenda por inactividad. Sin esto, el
  //                  primer visitante tras el sueño se come 21 segundos y un
  //                  error 1101 (medido en producción).
  //
  // A las en punto coinciden los dos y Cloudflare invoca el handler dos
  // veces, una por expresión. No es un problema: el barrido de carritos es
  // idempotente (compara abandonedEmailSentAt con updatedAt) y el ping no
  // escribe nada.
  "triggers": {
    "crons": ["0 * * * *", "*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
